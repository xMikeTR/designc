    { "about": "a text bug named by the legacy label is caught by the text finding that says what it was; no state means any state", "bucket": "caught",
      "bug": { "key": "QA-4", "description": "Print renamed", "where": { "role": "button", "name": "Print" }, "kind": "text" } },
    { "about": "a visibility bug on a control only the new app has is caught by its extra finding", "bucket": "caught",
      "bug": { "key": "QA-5", "description": "Help button should not be there", "where": { "role": "button", "name": "Help" }, "kind": "visibility", "state": "list" } },
    { "about": "a look bug is never this layer's", "bucket": "not_captured",
      "bug": { "key": "QA-6", "description": "Save is the wrong blue", "where": { "role": "button", "name": "Save" }, "kind": "look", "state": "new dialog" } },
    { "about": "a difference a requirement allows does not count as caught", "bucket": "not_flagged",
      "bug": { "key": "QA-7", "description": "Archive is gone", "where": { "role": "button", "name": "Archive" }, "kind": "missing", "state": "list" } },
    { "about": "a control recorded on both sides with no finding is a diff rule gap", "bucket": "not_flagged",
      "bug": { "key": "QA-8", "description": "Customer label wrong", "where": { "role": "textbox", "name": "Customer" }, "kind": "text", "state": "new dialog" } },
    { "about": "a state no step on this screen is labelled with was not recorded, even if another screen has it", "bucket": "state_not_recorded",
      "bug": { "key": "QA-9", "description": "Empty list message", "where": { "role": "text", "name": "No orders" }, "kind": "text", "state": "empty" } },
    { "about": "a control on neither side in that state means the scenario never reached it", "bucket": "state_not_recorded",
      "bug": { "key": "QA-10", "description": "Undo missing", "where": { "role": "button", "name": "Undo" }, "kind": "missing", "state": "new dialog" } },
    { "about": "a state whose step could not run was not recorded", "bucket": "state_not_recorded",
      "bug": { "key": "QA-11", "description": "Delete dialog text", "where": { "role": "dialog", "name": "Delete order" }, "kind": "text", "state": "confirm" } },
    { "about": "a finding of another kind on the same control does not catch it", "bucket": "not_flagged",
      "bug": { "key": "QA-12", "description": "Export label", "where": { "role": "button", "name": "Export" }, "kind": "text", "state": "list" } },
    { "about": "a bug without where or kind waits for a person", "bucket": "triage",
      "bug": { "key": "QA-13", "description": "Something is off", "actual": "header row misaligned", "expected": "header row as on legacy" } },
    { "about": "names are compared with volatile parts replaced and case ignored", "bucket": "not_flagged",
      "bug": { "key": "QA-14", "description": "Count wording", "where": { "role": "text", "name": "showing 5 Orders" }, "kind": "text", "state": "list" } }
