        "next": { "scenario": "orders-list", "side": "next", "steps": [
          { "n": 1, "action": "goto", "status": "ok", "elements": [
            { "key": "heading:Orders", "role": "heading", "name": "Orders", "enabled": true, "children": [] },
            { "key": "button:Refresh", "role": "button", "name": "Refresh", "enabled": true, "children": [] },
