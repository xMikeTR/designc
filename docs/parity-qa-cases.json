            { "kind": "missing", "key": "button:Archive", "severity": "covered", "msg": "button \"Archive\" is missing", "by": "drop-archive", "role": "button", "name": "Archive" },
            { "kind": "extra", "key": "button:Help", "severity": "fail", "msg": "button \"Help\" is not in legacy", "role": "button", "name": "Help" },
