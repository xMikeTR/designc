<Window x:Class="BookingCalculator.MainWindow" Title="Agreement booking">
  <StackPanel>
    <TextBox x:Name="Partner" />
    <TextBox x:Name="Limit" IsEnabled="{Binding LimitEnabled}" />
    <TextBox x:Name="Rate" IsEnabled="{Binding RateEnabled}" />
    <Button Content="Calculate" IsEnabled="{Binding CalculateEnabled}" />
    <TextBlock x:Name="Summary" />
  </StackPanel>
</Window>
