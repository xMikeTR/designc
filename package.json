{
  "name": "designc-ide",
  "productName": "designc",
  "version": "0.1.0",
  "description": "System design IDE: design compiler (S1), pipeline view (S2), improvement loop (S4)",
  "main": "main.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test \"test/**/*.test.js\"",
    "e2e": "playwright test",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "js-yaml": "^4.1.0",
    "monaco-editor": "0.52.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hiscox.designc",
    "productName": "designc",
    "files": [
      "main.js",
      "preload.js",
      "extract.js",
      "extract/**",
      "telemetry.js",
      "acp.js",
      "paths.js",
      "designc-mcp.js",
      "ledger-store.js",
      "git.js",
      "terminal.js",
      "llm-net.js",
      "sample-codebase/**",
      "renderer/**",
      "docs/guide.html",
      "sample-registry/**",
      "node_modules/monaco-editor/min/**",
      "node_modules/js-yaml/dist/**",
      "node_modules/@xterm/xterm/lib/**",
      "node_modules/@xterm/xterm/css/**",
      "node_modules/@xterm/addon-fit/lib/**",
      "node_modules/node-pty/**",
      "package.json"
    ],
    "asarUnpack": [
      "docs/guide.html",
      "sample-registry/**",
      "sample-codebase/**",
      "designc-mcp.js",
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
